<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchDisponible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtEstado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorConductor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/switchDisponible"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationConductor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <fragment
            android:id="@+id/mapaConductor"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:id="@+id/bottomSheetConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@android:color/white"
            android:elevation="12dp"
            android:padding="16dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="#BDBDBD"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- =============================== -->
                <!-- PANEL DE SOLICITUDES             -->
                <!-- =============================== -->

                <LinearLayout
                    android:id="@+id/panelSolicitudes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Solicitudes pendientes"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btnVolverAlViaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="← Volver al viaje"
                        android:layout_marginBottom="10dp"/>


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSolicitudes"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp"/>

                </LinearLayout>


                <!-- =============================== -->
                <!-- PANEL DE DETALLE                 -->
                <!-- =============================== -->

                <LinearLayout
                    android:id="@+id/panelDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtSolicitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No hay solicitudes pendientes"
                        android:textSize="18sp"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:id="@+id/txtCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cliente: Sin solicitudes"
                        android:textSize="18sp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/txtOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Origen:"
                        android:textSize="18sp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/txtReferencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Referencia:"
                        android:textSize="18sp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/txtDestino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Destino:"
                        android:textSize="18sp"
                        android:layout_marginTop="10dp"/>

                    <Button
                        android:id="@+id/btnVerSolicitudes"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:text="Ver solicitudes"
                        android:layout_marginTop="20dp"/>


                    <Button
                        android:id="@+id/btnActualizar"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:text="Ir hacia el cliente"
                        android:layout_marginTop="30dp"/>


                    <Button
                        android:id="@+id/btnAceptar"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:text="Aceptar Viaje"
                        android:layout_marginTop="20dp"/>

                    <Button
                        android:id="@+id/btnIniciarViaje"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:text="Iniciar Viaje"
                        android:layout_marginTop="20dp"/>

                    <Button
                        android:id="@+id/btnRechazar"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:text="Rechazar"
                        android:layout_marginTop="20dp"/>

                    <Button
                        android:id="@+id/btnFinalizarViaje"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:text="Finalizar Viaje"
                        android:layout_marginTop="20dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationConductor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_menu_conductor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>